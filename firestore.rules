rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 1. Users collection: user profiles
    match /users/{userId} {
      // Authenticated users can view profiles for identity verification
      allow read: if isAuthenticated();
      // Users can manage their own profile; admins can manage all
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Items collection: Lost and Found items catalog
    match /items/{itemId} {
      // Public directory read access for campus community
      allow read: if true;
      // Authenticated users can report lost or found items
      allow create: if isAuthenticated() && (
        request.resource.data.reportedBy.uid == request.auth.uid ||
        isAdmin()
      );
      // Item reporter or admin can edit item details
      allow update: if isAuthenticated() && (
        resource.data.reportedBy.uid == request.auth.uid ||
        isAdmin()
      );
      // Item reporter or admin can delete/close
      allow delete: if isAuthenticated() && (
        resource.data.reportedBy.uid == request.auth.uid ||
        isAdmin()
      );

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update, delete: if isAuthenticated()
          && resource.data.authorId == request.auth.uid;
      }

      match /reactions/{userId} {
        allow read: if true;
        allow create, update: if isAuthenticated()
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.type in ['like', 'love', 'support'];
        allow delete: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // 3. Claims collection: item claim requests & verification slips
    match /claims/{claimId} {
      // Claimant or admin can read the claim
      allow read: if isAuthenticated() && (
        resource.data.claimantUid == request.auth.uid ||
        resource.data.claimant.uid == request.auth.uid ||
        isAdmin()
      );
      // Any authenticated student/user can submit a claim
      allow create: if isAuthenticated();
      // Custodian officer / admin can verify, approve, reject, or mark returned
      allow update: if isAuthenticated() && (
        resource.data.claimantUid == request.auth.uid ||
        resource.data.claimant.uid == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 4. Matches collection: AI and algorithmic match candidates
    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 5. Notifications collection: alerts for matching and claim status updates
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && (
        resource.data.recipientUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
    }

    // 6. Audit Logs collection: chain of custody tracking
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      // Append-only audit records (immutable history)
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Default catch-all for development / testing mode
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
